#!/usr/bin/env bash
# Runs a command inside the pinned Linux toolchain; elsewhere it runs the command directly.
# ImageOS stays outside, so Forge identifies the environment by the toolchain it finds.
set -euo pipefail

if [[ $(uname -s) != Linux ]]; then
    exec "$@"
fi

image=$(docker build --quiet "$(dirname "$0")")
exec docker run --rm --network host \
    --user "$(id -u):$(id -g)" \
    --volume "$HOME:$HOME" \
    --volume /tmp:/tmp \
    --volume /opt/hostedtoolcache:/opt/hostedtoolcache \
    --workdir "$PWD" \
    --env-file <(env | grep -E '^(GITHUB_|RUNNER_TEMP=|GH_TOKEN=|PACKAGE=|PACKAGES=|REUSE_RUN=|CARGO_|RUSTUP_|GO[A-Z]*=)') \
    --env HOME="$HOME" \
    --env PATH="$PATH" \
    "$image" "$@"
